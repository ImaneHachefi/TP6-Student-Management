{
  "info": {
    "name": "Student Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1 - Ajouter un étudiant (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/students/save",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "save"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"LACHGAR\",\n  \"prenom\": \"Mohamed\",\n  \"dateNaissance\": \"1985-09-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2 - Lister les étudiants (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/all",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "all"
          ]
        }
      }
    },
    {
      "name": "3 - Compter les étudiants (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/count",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "count"
          ]
        }
      }
    },
    {
      "name": "4 - Étudiants par année (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/byYear",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "byYear"
          ]
        }
      }
    },
    {
      "name": "5 - Supprimer l'étudiant 1 (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/delete/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "delete",
            "1"
          ]
        }
      }
    }
  ]
}